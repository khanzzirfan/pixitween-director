# Server-side only. Never expose these to the browser bundle.
META_API_KEY=
META_SPARK_MODEL=muse-spark-1.3
CLIPPY_MCP_URL=
CLIPPY_TOKEN=
GLIMMER_BASE_URL=http://localhost:11434
GLIMMER_MODEL=muse-glimmer:30b-mlx
DIRECTOR_PASSCODE=
# Deployed host: set IS_SERVER=true to check DIRECTOR_PASSCODE and META_API_KEY. Unset, or with those keys missing, it runs like localhost.
IS_SERVER=
DIRECTOR_REPLAY=
DIRECTOR_RECORD=

# Other settings: defaults shown; an empty value means unset.
PORT=8787
PUBLIC_BASE_URL=
DATA_DIR=./data
GENERATE_MAX_PER_HOUR=4
FILMS_PER_HOUR_PER_IP=300
MAX_UPLOAD_MB=25
TRUST_FLY_CLIENT_IP=false
LOCAL_MODE=false
EDIT_BACKEND=spark
BASETEN_API_KEY=
GLIMMER_NUM_CTX=
MCP_EDIT_WAIT_MS=45000
META_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=
DIRECTOR_FIXTURES_DIR=fixtures/replay
DIRECTOR_SCENE_CONCURRENCY=1
META_MAX_INFLIGHT=8
FILMS_IN_FLIGHT_MAX=2
FILMS_QUEUE_MAX=4
FILMS_STARTS_PER_WINDOW=3
FILMS_WINDOW_SEC=300
# 3d (default): a new film is one 3D film checked on sheets. crew: the 2D crew and its 3D cut.
FILM_PATH=3d
CREW_ENABLED=true
PRODUCT_3D=false
# 1: the 3D product gets a Muse-drawn back and a measured depth (about +45 s and $0.045 a film). Off by default.
TURNAROUND=0
SHOWRUNNER_MODEL=muse-wonder-1.0
CREW_MAX_WORKERS=4
CREW_FILM_BUDGET_USD=1.5
CREW_TAKES_MAX=3
CREW_INBOX_DEBOUNCE_MS=1500
CREW_CAPTURE_TIMEOUT_MS=20000
CREW_MAX_FIXES_PER_SCENE=3
CREW_AUTO_FINISH=true
CREW_FILM_DEADLINE_MS=180000
CREW_BUILD_MAX_TURNS=3
CREW_IDLE_END_MS=90000
CREW_MAX_AUTO_CRITIQUES=3
LINEUP_CONCURRENCY=2
LINEUP_FILM_DEADLINE_MS=360000
LINEUP_MAX_FIXES_PER_SCENE=1
LINEUP_MAX_AUTO_CRITIQUES=1
