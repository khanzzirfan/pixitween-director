# Server-side only. Never expose these to the browser bundle. Copy to .env and fill in what you need.
# An empty value means "use the default" (shown in the comment above each line).

# Secrets (leave empty here; set them in .env, which is gitignored)
META_API_KEY=
MODEL_API_KEY=
CLIPPY_TOKEN=
BASETEN_API_KEY=
DIRECTOR_PASSCODE=

# Meta Model API. Defaults: https://api.meta.ai/v1 and muse-spark-1.3-contributor
META_BASE_URL=
META_SPARK_MODEL=muse-spark-1.3-contributor

# Clippy (generate mode)
CLIPPY_MCP_URL=

# Local mode (Muse Glimmer through Ollama). Defaults: http://localhost:11434 and muse-glimmer:30b-mlx
GLIMMER_BASE_URL=http://localhost:11434
GLIMMER_MODEL=muse-glimmer:30b-mlx
GLIMMER_NUM_CTX=
LOCAL_MODE=
# spark | glimmer | spark-open. Default: spark
# spark-open needs BASETEN_API_KEY (model meta-models/muse-spark-open-1026 on https://inference.baseten.co/v1).
# Only chat edits use it. See docs/baseten-spark-open.md.
EDIT_BACKEND=

# Server. Defaults: PORT 8787, PUBLIC_BASE_URL http://localhost:<PORT>, DATA_DIR ./data
PORT=
PUBLIC_BASE_URL=
DATA_DIR=
# Default 25
MAX_UPLOAD_MB=
TRUST_FLY_CLIENT_IP=

# Limits. Defaults: 4 generate calls per hour, 3 films per hour per IP, 45000 ms chat edit wait
GENERATE_MAX_PER_HOUR=
FILMS_PER_HOUR_PER_IP=
MCP_EDIT_WAIT_MS=

# Concurrency. Defaults: 1 scene at a time (1-8), 8 Meta requests in flight (1-16)
DIRECTOR_SCENE_CONCURRENCY=
META_MAX_INFLIGHT=

# Film admission. Defaults: 2 films at once (1-6), queue of 4 (0-20), 3 starts per 300 s window (1-50, 30-3600)
FILMS_IN_FLIGHT_MAX=
FILMS_QUEUE_MAX=
FILMS_STARTS_PER_WINDOW=
FILMS_WINDOW_SEC=

# Offline tests: 1 replays recorded Meta responses from DIRECTOR_FIXTURES_DIR (default fixtures/replay), 1 records them.
# The two are mutually exclusive.
DIRECTOR_REPLAY=
DIRECTOR_RECORD=
DIRECTOR_FIXTURES_DIR=

# The Muse crew (S12). Defaults in brackets.
# 0 or false turns the crew off, so new films use the single director [on]
CREW_ENABLED=
# Orchestration engine: native (default) or langgraph (experimental; see docs/hackathon/10-langgraph-orchestration.md) [native]
CREW_ENGINE=
# 1 or true lets scenes show the product as a turning 3D model (needs the engine's model3d layer) [off]
PRODUCT_3D=
# Model that leads the crew [muse-wonder-1.0]
SHOWRUNNER_MODEL=
# Workers running at once, 1-8 [4]
CREW_MAX_WORKERS=
# Spend cap per film in USD, 0.1-20 [1.5]
CREW_FILM_BUDGET_USD=
# Takes per scene, 2-3 [3]
CREW_TAKES_MAX=
# Wait after the last job result before the showrunner wakes, ms, 0-10000 [1500]
CREW_INBOX_DEBOUNCE_MS=
# How long the critic waits for browser frames, ms, 5000-600000 [20000]
CREW_CAPTURE_TIMEOUT_MS=
# Max fix jobs the crew may spend on one scene before finish accepts its findings.
CREW_MAX_FIXES_PER_SCENE=
# The crew finishes itself after two idle showrunner turns following the done nudge.
CREW_AUTO_FINISH=
# How long an idle crew session stays open, ms, 60000-3600000 [600000]
CREW_IDLE_END_MS=
# Hosted tracing (LangSmith/LangChain) is never used. Do not set LANGSMITH_* or LANGCHAIN_*:
# the server warns at startup and sends no film data to any tracing service.
