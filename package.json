{
  "name": "pixitween-director",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "live": "tsx scripts/live/run.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "start": "tsx server/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hono/node-server": "^1.19.17",
    "@meta-sam/parser": "0.1.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@pixi/react": "^8.0.5",
    "@pixi/sound": "^6.0.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "audiomotion-analyzer": "^4.5.4",
    "gsap": "^3.15.0",
    "hono": "^4.13.14",
    "lottie-web": "^5.13.0",
    "mediabunny": "^1.62.1",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reacthub-pixitweenjs": "^0.3.0-alpha.5",
    "sharp": "^0.35.5",
    "three": "^0.184.0",
    "undici": "^7.30.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  }
}
