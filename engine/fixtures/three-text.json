      "objects": [
        {
          "id": "title",
          "geometry": { "type": "text3d", "font": "bold", "text": "Fresh every\nmorning", "size": 0.7, "depth": 0.25, "bevel": {}, "lineHeight": 1.25 },
          "position": [0, 0.6, 0],
          "material": { "color": "#ffd27a", "roughness": 0.3, "metalness": 0.2 }
        },
        {
          "id": "tagline",
          "geometry": { "type": "text3d", "font": "bold", "text": "per glyph motion", "size": 0.38, "depth": 0.1 },
          "position": [0, -1.5, 0],
          "material": { "color": "#4fc3f7", "roughness": 0.35 }
        }
      ],
      "end": 8,
      "enter": { "name": "glyphPop", "target": "glyphs:title" },
      "loop": { "name": "glyphWave", "target": "glyphs:title" },
      "exit": { "name": "glyphFadeOut", "target": "glyphs:title", "duration": 2.4 },
      "tweens": [
        {
          "target": "words:title",
          "at": 2.4,
          "duration": 0.8,
          "ease": "power2.inOut",
