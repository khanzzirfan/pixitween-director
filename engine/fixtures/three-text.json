{
  "version": 1,
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "duration": 8,
  "background": "#0b0f14",
  "assets": {
    "bold": { "type": "font", "url": "/fonts/helvetiker_bold.typeface.json" }
  },
  "layers": [
    {
      "id": "stage",
      "type": "three",
      "x": 960,
      "y": 540,
      "width": 1800,
      "height": 1000,
      "background": "#0b0f14",
      "lighting": { "preset": "studio" },
