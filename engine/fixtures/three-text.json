        {
          "target": "glyphs:tagline",
          "at": 0.5,
          "duration": 0.6,
          "ease": "power3.out",
          "from": { "offset.y": -0.4, "alpha": 0 },
          "to": { "offset.y": 0, "alpha": 1 },
          "stagger": { "each": 0.05, "from": "center" }
        },
        {
          "target": "glyphs:tagline",
          "at": 5.8,
          "duration": 0.4,
          "from": { "alpha": 1 },
          "to": { "alpha": 0 },
